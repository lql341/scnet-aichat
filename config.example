# Copy this file to ~/.config/scnet-aichat/config and adjust as needed.

SCNET_PROFILE=kseshell
SCNET_PARTITION=kshdnormal

# Leave SCNET_REMOTE_HOME empty to discover it over SSH.
# SCNET_REMOTE_HOME=/public/home/your-user

# Remote application directory used for the worker, requests, and job logs.
# SCNET_REMOTE_APP_DIR=/public/home/your-user/.scnet-aichat

# Runtime and model paths. Defaults are derived from SCNET_REMOTE_HOME.
# SCNET_LLAMA_CLI=/public/home/your-user/eva-k100/llama.cpp-b5046/build-gfx906/bin/llama-cli
# SCNET_MODEL_14B_PATH=/public/home/your-user/models/EVA-Qwen2.5-14B-v0.2-GGUF-Q4_0/EVA-Qwen2.5-14B-v0.2-Q4_0.gguf
# SCNET_MODEL_32B_PATH=/public/home/your-user/models/EVA-Qwen2.5-32B-v0.2-GGUF/EVA-Qwen2.5-32B-v0.2-Q4_K_M.gguf

SCNET_GCC_MODULE=compiler/gcc/11.2.0
SCNET_DTK_MODULE=compiler/dtk/26.04

SCNET_MODEL=14b
SCNET_MODE=job
SCNET_PRESET=default
SCNET_MAX_TOKENS=512
SCNET_POLL_SECONDS=5
# Setting SCNET_SYSTEM_PROMPT overrides SCNET_PRESET and selects preset=custom.
# SCNET_SYSTEM_PROMPT="You are a helpful assistant. Answer coherently and directly."

# Persistent server settings. /mode server or --mode server starts it on demand.
# SCNET_LLAMA_SERVER=/public/home/your-user/eva-k100/llama.cpp-b5046/build-gfx906/bin/llama-server
SCNET_SERVER_PORT=18080

# Resource mapping. Keep the CPU/DCU ratio valid for the target partition.
SCNET_14B_GPUS=1
SCNET_14B_CPUS=8
SCNET_14B_MEM=27gb
SCNET_14B_TIME=02:00:00

SCNET_32B_GPUS=4
SCNET_32B_CPUS=32
SCNET_32B_MEM=110gb
SCNET_32B_TIME=03:00:00
