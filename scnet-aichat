#!/usr/bin/env bash

# SCNet AI Chat: Bash 3.2 compatible Slurm-backed chat client.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_FILE="${SCNET_AICHAT_CONFIG:-${HOME}/.config/scnet-aichat/config}"
CONFIG_DIR="$(dirname "$CONFIG_FILE")"
export SCNET_AICHAT_CONFIG_DIR="${SCNET_AICHAT_CONFIG_DIR:-$CONFIG_DIR}"

config_die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

load_config() {
  config_path="$1"
  while IFS= read -r config_line || [[ -n "$config_line" ]]; do
    config_line="${config_line#"${config_line%%[![:space:]]*}"}"
    case "$config_line" in ""|\#*) continue ;; esac
    config_key="${config_line%%=*}"
    config_value="${config_line#*=}"
    [[ "$config_key" != "$config_line" ]] ||
      config_die "invalid config line in $config_path"
    case "$config_key" in
      SCNET_[A-Z0-9_]*) ;;
      *) config_die "unsupported config key: $config_key" ;;
    esac
    case "$config_key" in
      *ACCESS_KEY*|*SECRET_KEY*|*API_KEY*|*TOKEN*|*PASSWORD*)
        config_die "credentials are not allowed in config: $config_key"
        ;;
      SCNET_OPENAPI_REGION_ID|SCNET_OPENAPI_SCHEDULER_ID)
        config_die "$config_key is managed by scnet-aichat setup"
        ;;
    esac
    config_value="${config_value#"${config_value%%[![:space:]]*}"}"
    config_value="${config_value%"${config_value##*[![:space:]]}"}"
    case "$config_value" in
      \"*\")
        [[ "${config_value: -1}" == '"' ]] ||
          config_die "unterminated quoted value for $config_key"
        config_value="${config_value:1:${#config_value}-2}"
        ;;
      \'*\')
        [[ "${config_value: -1}" == "'" ]] ||
          config_die "unterminated quoted value for $config_key"
        config_value="${config_value:1:${#config_value}-2}"
        ;;
    esac
    printf -v "$config_key" '%s' "$config_value"
  done < "$config_path"
}

if [[ -f "$CONFIG_FILE" ]]; then
  load_config "$CONFIG_FILE"
fi

BACKEND="${SCNET_BACKEND:-}"
if [[ -z "$BACKEND" && -f "${CONFIG_DIR}/backend" ]]; then
  IFS= read -r BACKEND < "${CONFIG_DIR}/backend" || true
fi
BACKEND="${BACKEND:-ssh}"
PROFILE="${SCNET_PROFILE:-kseshell}"
PARTITION="${SCNET_PARTITION:-kshdnormal}"
MODEL="${SCNET_MODEL:-14b}"
MODE="${SCNET_MODE:-job}"
MAX_TOKENS="${SCNET_MAX_TOKENS:-512}"
POLL_SECONDS="${SCNET_POLL_SECONDS:-5}"
PRESET="${SCNET_PRESET:-default}"
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Answer coherently and directly."
EVA_RP_SYSTEM_PROMPT="You are an immersive fictional roleplay assistant. Follow the character card and established setting precisely. Stay in character, preserve personality, relationships, emotional continuity, memories, and scene details across replies. Write vivid dialogue, actions, atmosphere, and sensory detail without summarizing the scene or speaking for the user. Let the user control their own character. Mature fictional themes may be explored only when every participant is explicitly an adult and all intimate activity is consensual. Never involve minors or ambiguous ages."
if [[ -n "${SCNET_SYSTEM_PROMPT+x}" ]]; then
  SYSTEM_PROMPT="$SCNET_SYSTEM_PROMPT"
  PRESET="custom"
else
  case "$PRESET" in
    default) SYSTEM_PROMPT="$DEFAULT_SYSTEM_PROMPT" ;;
    eva-rp) SYSTEM_PROMPT="$EVA_RP_SYSTEM_PROMPT" ;;
    *) SYSTEM_PROMPT="$DEFAULT_SYSTEM_PROMPT" ;;
  esac
fi
WAIT_FOR_RESULT=1
DRY_RUN=0

GCC_MODULE="${SCNET_GCC_MODULE:-compiler/gcc/11.2.0}"
DTK_MODULE="${SCNET_DTK_MODULE:-compiler/dtk/26.04}"

R14_GPUS="${SCNET_14B_GPUS:-1}"
R14_CPUS="${SCNET_14B_CPUS:-8}"
R14_MEM="${SCNET_14B_MEM:-27gb}"
R14_TIME="${SCNET_14B_TIME:-02:00:00}"
R32_GPUS="${SCNET_32B_GPUS:-4}"
R32_CPUS="${SCNET_32B_CPUS:-32}"
R32_MEM="${SCNET_32B_MEM:-110gb}"
R32_TIME="${SCNET_32B_TIME:-03:00:00}"

STATE_DIR="${SCNET_AICHAT_STATE_DIR:-${HOME}/.scnet-aichat}"
JOBS_FILE="${STATE_DIR}/jobs.tsv"

REMOTE_HOME="${SCNET_REMOTE_HOME:-}"
REMOTE_APP_DIR="${SCNET_REMOTE_APP_DIR:-}"
LLAMA_CLI="${SCNET_LLAMA_CLI:-}"
MODEL_14B_PATH="${SCNET_MODEL_14B_PATH:-}"
MODEL_32B_PATH="${SCNET_MODEL_32B_PATH:-}"
LLAMA_SERVER="${SCNET_LLAMA_SERVER:-}"
SERVER_PORT="${SCNET_SERVER_PORT:-18080}"
SERVER_START_TIMEOUT="${SCNET_SERVER_START_TIMEOUT:-900}"
OPENAPI_TIMEOUT="${SCNET_OPENAPI_TIMEOUT:-30}"

find_worker() {
  for candidate in \
    "${SCNET_AICHAT_WORKER_LOCAL:-}" \
    "${SCRIPT_DIR}/worker/scnet-aichat-worker.slurm" \
    "${SCRIPT_DIR}/../share/scnet-aichat/worker/scnet-aichat-worker.slurm"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      WORKER_LOCAL="$candidate"
      return 0
    fi
  done
  return 1
}

find_openapi_helper() {
  for candidate in \
    "${SCNET_AICHAT_OPENAPI_HELPER:-}" \
    "${SCRIPT_DIR}/scripts/scnet-openapi.py" \
    "${SCRIPT_DIR}/../share/scnet-aichat/scripts/scnet-openapi.py"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      OPENAPI_HELPER="$candidate"
      return 0
    fi
  done
  return 1
}

find_server_script() {
  for candidate in \
    "${SCRIPT_DIR}/server/llama-server.slurm" \
    "${SCRIPT_DIR}/../share/scnet-aichat/server/llama-server.slurm"; do
    if [[ -f "$candidate" ]]; then
      SERVER_SCRIPT_LOCAL="$candidate"
      return 0
    fi
  done
  return 1
}

reset_remote_layout() {
  REMOTE_HOME="${SCNET_REMOTE_HOME:-}"
  REMOTE_APP_DIR="${SCNET_REMOTE_APP_DIR:-}"
  LLAMA_CLI="${SCNET_LLAMA_CLI:-}"
  MODEL_14B_PATH="${SCNET_MODEL_14B_PATH:-}"
  MODEL_32B_PATH="${SCNET_MODEL_32B_PATH:-}"
  LLAMA_SERVER="${SCNET_LLAMA_SERVER:-}"
}

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  BOLD="$(tput bold 2>/dev/null || true)"
  DIM="$(tput dim 2>/dev/null || true)"
  GREEN="$(tput setaf 2 2>/dev/null || true)"
  YELLOW="$(tput setaf 3 2>/dev/null || true)"
  RED="$(tput setaf 1 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
else
  BOLD=""; DIM=""; GREEN=""; YELLOW=""; RED=""; RESET=""
fi

say() { printf '%s\n' "$*"; }
info() { printf '%s%s%s\n' "$DIM" "$*" "$RESET"; }
ok() { printf '%s%s%s\n' "$GREEN" "$*" "$RESET"; }
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$RESET" >&2; }
die() { printf '%sError: %s%s\n' "$RED" "$*" "$RESET" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  scnet-aichat                           interactive panel
  scnet-aichat setup [new|modify|status|reset|reset-credentials]
  scnet-aichat install                   install/update remote worker
  scnet-aichat doctor                    validate local and remote setup
  scnet-aichat ask "question"            submit and wait
  scnet-aichat status JOB_ID
  scnet-aichat result JOB_ID
  scnet-aichat cancel JOB_ID
  scnet-aichat history

Options (before the command):
  --backend ssh|openapi
  --profile NAME
  --partition NAME
  --model 14b|32b
  --mode job|server
  --preset default|eva-rp
  --max-tokens N
  --poll-seconds N
  --system TEXT
  --no-wait
  --dry-run
EOF
}

require_tools() {
  tools="awk mktemp"
  if [[ "$BACKEND" == "ssh" ]]; then
    tools="$tools ssh scp"
  else
    tools="$tools python3"
  fi
  for tool in $tools; do
    command -v "$tool" >/dev/null 2>&1 || die "missing local command: $tool"
  done
}

openapi_run() {
  find_openapi_helper || die "cannot find scripts/scnet-openapi.py"
  command_args=()
  command_args+=(--timeout "$OPENAPI_TIMEOUT")
  python3 "$OPENAPI_HELPER" "${command_args[@]}" "$@"
}

ssh_run() {
  LC_ALL=C LANG=C ssh -n -o BatchMode=yes "$PROFILE" "$1"
}

validate_name() {
  value="$1"
  label="$2"
  case "$value" in
    ""|*[!A-Za-z0-9._-]*) die "unsafe $label: $value" ;;
  esac
}

validate_uint() {
  value="$1"
  label="$2"
  case "$value" in
    ""|*[!0-9]*) die "$label must be an integer" ;;
  esac
}

validate_memory() {
  value="$1"
  label="$2"
  if [[ ! "$value" =~ ^[0-9]+([KkMmGgTt][Bb]?)?$ ]]; then
    die "$label has an invalid format"
  fi
}

validate_walltime() {
  value="$1"
  label="$2"
  if [[ ! "$value" =~ ^([0-9]+-)?[0-9]{1,3}:[0-9]{2}:[0-9]{2}$ ]]; then
    die "$label must use HH:MM:SS or D-HH:MM:SS"
  fi
}

validate_remote_path() {
  value="$1"
  label="$2"
  case "$value" in
    /*) ;;
    *) die "$label must be an absolute path" ;;
  esac
  case "$value" in
    *[!A-Za-z0-9_./+-]*) die "unsafe $label" ;;
  esac
}

validate_settings() {
  case "$BACKEND" in ssh|openapi) ;; *) die "backend must be ssh or openapi" ;; esac
  validate_name "$PROFILE" "SSH profile"
  validate_name "$PARTITION" "partition"
  case "$MODEL" in 14b|32b) ;; *) die "model must be 14b or 32b" ;; esac
  case "$MODE" in job|server) ;; *) die "mode must be job or server" ;; esac
  case "$PRESET" in default|eva-rp|custom) ;; *) die "preset must be default or eva-rp" ;; esac
  validate_uint "$MAX_TOKENS" "max-tokens"
  (( MAX_TOKENS >= 1 && MAX_TOKENS <= 4096 )) || die "max-tokens must be 1-4096"
  validate_uint "$POLL_SECONDS" "poll-seconds"
  (( POLL_SECONDS >= 1 && POLL_SECONDS <= 300 )) || die "poll-seconds must be 1-300"
  validate_uint "$SERVER_START_TIMEOUT" "server start timeout"
  (( SERVER_START_TIMEOUT >= 30 && SERVER_START_TIMEOUT <= 86400 )) ||
    die "server start timeout must be 30-86400"
  validate_uint "$OPENAPI_TIMEOUT" "OpenAPI timeout"
  (( OPENAPI_TIMEOUT >= 1 && OPENAPI_TIMEOUT <= 600 )) ||
    die "OpenAPI timeout must be 1-600"
  case "$GCC_MODULE:$DTK_MODULE" in
    *[!A-Za-z0-9_./:+-]*) die "unsafe module name" ;;
  esac
}

resolve_remote_layout() {
  if [[ -z "$REMOTE_HOME" ]]; then
    if [[ "$BACKEND" == "openapi" ]]; then
      if (( DRY_RUN == 1 )); then
        REMOTE_HOME="/remote/home"
      else
        context="$(openapi_run context)" || die "cannot discover OpenAPI context"
        IFS=$'\t' read -r REMOTE_HOME OPENAPI_USERNAME \
          OPENAPI_RESOLVED_REGION OPENAPI_RESOLVED_SCHEDULER <<< "$context"
      fi
    else
      REMOTE_HOME="$(ssh_run 'printf %s "$HOME"')" ||
        die "cannot discover remote HOME"
    fi
  fi
  validate_remote_path "$REMOTE_HOME" "remote HOME"

  [[ -n "$REMOTE_APP_DIR" ]] || REMOTE_APP_DIR="${REMOTE_HOME}/.scnet-aichat"
  [[ -n "$LLAMA_CLI" ]] ||
    LLAMA_CLI="${REMOTE_HOME}/eva-k100/llama.cpp-b5046/build-gfx906/bin/llama-cli"
  [[ -n "$MODEL_14B_PATH" ]] ||
    MODEL_14B_PATH="${REMOTE_HOME}/models/EVA-Qwen2.5-14B-v0.2-GGUF-Q4_0/EVA-Qwen2.5-14B-v0.2-Q4_0.gguf"
  [[ -n "$MODEL_32B_PATH" ]] ||
    MODEL_32B_PATH="${REMOTE_HOME}/models/EVA-Qwen2.5-32B-v0.2-GGUF/EVA-Qwen2.5-32B-v0.2-Q4_K_M.gguf"
  [[ -n "$LLAMA_SERVER" ]] ||
    LLAMA_SERVER="${REMOTE_HOME}/eva-k100/llama.cpp-b5046/build-gfx906/bin/llama-server"

  validate_remote_path "$REMOTE_APP_DIR" "remote app dir"
  validate_remote_path "$LLAMA_CLI" "llama-cli path"
  validate_remote_path "$MODEL_14B_PATH" "14B model path"
  validate_remote_path "$MODEL_32B_PATH" "32B model path"
  validate_remote_path "$LLAMA_SERVER" "llama-server path"
  validate_uint "$SERVER_PORT" "server port"
  (( SERVER_PORT >= 1024 && SERVER_PORT <= 65535 )) || die "server port must be 1024-65535"
}

init_state() {
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  if [[ ! -f "$JOBS_FILE" ]]; then
    : > "$JOBS_FILE" || die "cannot create $JOBS_FILE"
    chmod 600 "$JOBS_FILE" 2>/dev/null || true
  fi
}

install_worker() {
  validate_settings
  require_tools
  resolve_remote_layout
  find_worker || die "cannot find scnet-aichat-worker.slurm"
  if [[ "$BACKEND" == "openapi" ]]; then
    openapi_run install-worker \
      --worker "$WORKER_LOCAL" \
      --remote-app-dir "$REMOTE_APP_DIR" >/dev/null ||
      die "worker upload through OpenAPI failed"
    ok "Installed OpenAPI worker"
    return 0
  fi

  find_server_script || die "cannot find server/llama-server.slurm"

  remote_worker="${REMOTE_APP_DIR}/worker.slurm"
  remote_tmp="${remote_worker}.tmp.$$"
  remote_server="${REMOTE_APP_DIR}/server/llama-server.slurm"
  remote_server_tmp="${remote_server}.tmp.$$"
  ssh_run "mkdir -p '${REMOTE_APP_DIR}/requests' '${REMOTE_APP_DIR}/server' && chmod 700 '$REMOTE_APP_DIR' '${REMOTE_APP_DIR}/requests' '${REMOTE_APP_DIR}/server'" ||
    die "cannot create remote app directory"
  LC_ALL=C LANG=C scp -q "$WORKER_LOCAL" "${PROFILE}:${remote_tmp}" ||
    die "worker upload failed"
  ssh_run "chmod 755 '$remote_tmp' && mv '$remote_tmp' '$remote_worker'" ||
    die "worker install failed"
  LC_ALL=C LANG=C scp -q "$SERVER_SCRIPT_LOCAL" "${PROFILE}:${remote_server_tmp}" ||
    die "server script upload failed"
  ssh_run "chmod 755 '$remote_server_tmp' && mv '$remote_server_tmp' '$remote_server'" ||
    die "server script install failed"
  ok "Installed worker and server script"
}

ensure_worker() {
  if [[ "$BACKEND" == "openapi" ]]; then
    find_worker || die "cannot find scnet-aichat-worker.slurm"
    openapi_run install-worker \
      --worker "$WORKER_LOCAL" \
      --remote-app-dir "$REMOTE_APP_DIR" >/dev/null ||
      die "worker upload through OpenAPI failed"
    return 0
  fi
  remote_worker="${REMOTE_APP_DIR}/worker.slurm"
  if ! ssh_run "test -x '$remote_worker'" >/dev/null 2>&1; then
    warn "Remote worker is missing; installing it now."
    install_worker
  fi
  if ! ssh_run "test -x '${REMOTE_APP_DIR}/server/llama-server.slurm'" >/dev/null 2>&1; then
    install_worker
  fi
}

set_resources() {
  case "$MODEL" in
    14b)
      JOB_GPUS="$R14_GPUS"; JOB_CPUS="$R14_CPUS"; JOB_MEM="$R14_MEM"; JOB_TIME="$R14_TIME"
      MODEL_PATH="$MODEL_14B_PATH"
      ;;
    32b)
      JOB_GPUS="$R32_GPUS"; JOB_CPUS="$R32_CPUS"; JOB_MEM="$R32_MEM"; JOB_TIME="$R32_TIME"
      MODEL_PATH="$MODEL_32B_PATH"
      ;;
  esac
  validate_uint "$JOB_GPUS" "GPU count"
  validate_uint "$JOB_CPUS" "CPU count"
  validate_memory "$JOB_MEM" "memory"
  validate_walltime "$JOB_TIME" "walltime"
}

record_job() {
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$1" "$2" "$3" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$4" >> "$JOBS_FILE"
}

lookup_request() {
  awk -F '	' -v id="$1" '$1 == id { value = $2 } END { print value }' "$JOBS_FILE"
}

lookup_backend() {
  awk -F '	' -v id="$1" '
    $1 == id { found = 1; value = $5 }
    END {
      if (found) print (value == "" ? "ssh" : value)
    }
  ' \
    "$JOBS_FILE"
}

job_state() {
  if [[ "$BACKEND" == "openapi" ]]; then
    openapi_run job "$1" --field state 2>/dev/null || true
    return
  fi
  line="$(ssh_run "sacct -j '$1' --format=State,ExitCode -n -P | head -n 1" 2>/dev/null || true)"
  state="${line%%|*}"
  state="$(printf '%s' "$state" | tr -d '[:space:]')"
  if [[ -z "$state" ]]; then
    state="$(ssh_run "squeue -h -j '$1' -o '%T' | head -n 1" 2>/dev/null || true)"
    state="$(printf '%s' "$state" | tr -d '[:space:]')"
  fi
  printf '%s\n' "$state"
}

redact_remote_path() {
  value="$1"
  if [[ -n "$REMOTE_HOME" && "$value" == "$REMOTE_HOME"* ]]; then
    printf '$REMOTE_HOME%s\n' "${value#"$REMOTE_HOME"}"
  else
    printf '%s\n' "$value"
  fi
}

submit_prompt_openapi() {
  prompt="$1"
  request_id="$(date '+%Y%m%dT%H%M%S')-$$-${RANDOM}"
  request_dir="${REMOTE_APP_DIR}/requests/${request_id}"
  remote_worker="${REMOTE_APP_DIR}/scnet-aichat-worker.slurm"

  worker_command="export EVA_REQUEST_DIR='${request_dir}' EVA_MODEL_KEY='${MODEL}'"
  worker_command="$worker_command SCNET_GCC_MODULE='${GCC_MODULE}'"
  worker_command="$worker_command SCNET_DTK_MODULE='${DTK_MODULE}';"
  worker_command="$worker_command bash -l '${remote_worker}'"

  if (( DRY_RUN == 1 )); then
    say "backend=openapi"
    say "model=$MODEL"
    say "model_path=$(redact_remote_path "$MODEL_PATH")"
    say "llama_cli=$(redact_remote_path "$LLAMA_CLI")"
    say "work_dir=$(redact_remote_path "$request_dir")"
    say "resources=dcu:${JOB_GPUS} cpu:${JOB_CPUS} mem:${JOB_MEM} time:${JOB_TIME}"
    say "command=$worker_command" | sed "s#${REMOTE_HOME}#\\\$REMOTE_HOME#g"
    return 0
  fi

  init_state
  find_worker || die "cannot find scnet-aichat-worker.slurm"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/scnet-aichat.XXXXXX")" ||
    die "cannot create temporary directory"
  trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
  printf '%s\n' "$prompt" > "${tmp_dir}/prompt.txt"
  printf '%s\n' "$SYSTEM_PROMPT" > "${tmp_dir}/system.txt"
  printf '%s\n' "$MAX_TOKENS" > "${tmp_dir}/max_tokens"
  printf '%s\n' "$LLAMA_CLI" > "${tmp_dir}/llama_cli"
  printf '%s\n' "$MODEL_PATH" > "${tmp_dir}/model_path"

  job_id="$(openapi_run submit-chat \
    --worker "$WORKER_LOCAL" \
    --request-dir "$request_dir" \
    --file "${tmp_dir}/prompt.txt" \
    --file "${tmp_dir}/system.txt" \
    --file "${tmp_dir}/max_tokens" \
    --file "${tmp_dir}/llama_cli" \
    --file "${tmp_dir}/model_path" \
    --name "scnet-aichat-${MODEL}" \
    --command "$worker_command" \
    --queue "$PARTITION" \
    --cpus "$JOB_CPUS" \
    --dcus "$JOB_GPUS" \
    --memory "$JOB_MEM" \
    --walltime "$JOB_TIME" \
    --stdout "${request_dir}/slurm-%j.out" \
    --stderr "${request_dir}/slurm-%j.err")" ||
    die "OpenAPI job submission failed"
  rm -rf "$tmp_dir"
  trap - EXIT HUP INT TERM
  case "$job_id" in ""|*[!0-9]*) die "cannot parse OpenAPI job id: $job_id" ;; esac
  record_job "$job_id" "$request_dir" "$MODEL" "openapi"
  ok "Submitted job=$job_id backend=openapi model=$MODEL dcu=$JOB_GPUS cpu=$JOB_CPUS mem=$JOB_MEM"

  if (( WAIT_FOR_RESULT == 1 )); then
    wait_for_job "$job_id"
  else
    say "Run later: $0 result $job_id"
  fi
}

submit_prompt() {
  prompt="$1"
  validate_settings
  require_tools
  resolve_remote_layout
  set_resources

  if [[ "$BACKEND" == "openapi" ]]; then
    submit_prompt_openapi "$prompt"
    return
  fi

  request_id="$(date '+%Y%m%dT%H%M%S')-$$-${RANDOM}"
  request_dir="${REMOTE_APP_DIR}/requests/${request_id}"
  remote_worker="${REMOTE_APP_DIR}/worker.slurm"

  submit_cmd="sbatch --parsable --partition=${PARTITION}"
  submit_cmd="$submit_cmd --gres=dcu:${JOB_GPUS} --cpus-per-task=${JOB_CPUS}"
  submit_cmd="$submit_cmd --mem=${JOB_MEM} --time=${JOB_TIME}"
  submit_cmd="$submit_cmd --job-name=scnet-aichat-${MODEL}"
  submit_cmd="$submit_cmd --output=${request_dir}/slurm-%j.out"
  submit_cmd="$submit_cmd --error=${request_dir}/slurm-%j.err"
  submit_cmd="$submit_cmd --export=LC_ALL=C,LANG=C,LANGUAGE=C"
  submit_cmd="$submit_cmd,EVA_REQUEST_DIR=${request_dir},EVA_MODEL_KEY=${MODEL}"
  submit_cmd="$submit_cmd,SCNET_GCC_MODULE=${GCC_MODULE},SCNET_DTK_MODULE=${DTK_MODULE}"
  submit_cmd="$submit_cmd ${remote_worker}"

  if (( DRY_RUN == 1 )); then
    say "backend=ssh"
    say "model=$MODEL"
    say "model_path=$(redact_remote_path "$MODEL_PATH")"
    say "llama_cli=$(redact_remote_path "$LLAMA_CLI")"
    say "resources=dcu:${JOB_GPUS} cpu:${JOB_CPUS} mem:${JOB_MEM} time:${JOB_TIME}"
    say "$submit_cmd" | sed "s#${REMOTE_HOME}#\\\$REMOTE_HOME#g"
    return 0
  fi

  init_state
  ensure_worker
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/scnet-aichat.XXXXXX")" ||
    die "cannot create temporary directory"
  trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
  printf '%s\n' "$prompt" > "${tmp_dir}/prompt.txt"
  printf '%s\n' "$SYSTEM_PROMPT" > "${tmp_dir}/system.txt"
  printf '%s\n' "$MAX_TOKENS" > "${tmp_dir}/max_tokens"
  printf '%s\n' "$LLAMA_CLI" > "${tmp_dir}/llama_cli"
  printf '%s\n' "$MODEL_PATH" > "${tmp_dir}/model_path"

  ssh_run "mkdir -p '$request_dir' && chmod 700 '$request_dir'" || {
    rm -rf "$tmp_dir"
    die "cannot create remote request directory"
  }
  LC_ALL=C LANG=C scp -q \
    "${tmp_dir}/prompt.txt" "${tmp_dir}/system.txt" "${tmp_dir}/max_tokens" \
    "${tmp_dir}/llama_cli" "${tmp_dir}/model_path" \
    "${PROFILE}:${request_dir}/" || {
      rm -rf "$tmp_dir"
      die "request upload failed"
    }
  rm -rf "$tmp_dir"
  trap - EXIT HUP INT TERM

  output="$(ssh_run "$submit_cmd")" || die "sbatch failed"
  job_id="${output%%;*}"
  case "$job_id" in ""|*[!0-9]*) die "cannot parse job id: $output" ;; esac
  record_job "$job_id" "$request_dir" "$MODEL" "ssh"
  ok "Submitted job=$job_id model=$MODEL dcu=$JOB_GPUS cpu=$JOB_CPUS mem=$JOB_MEM"

  if (( WAIT_FOR_RESULT == 1 )); then
    wait_for_job "$job_id"
  else
    say "Run later: $0 result $job_id"
  fi
}

server_job_id() {
  ssh_run "cat '${REMOTE_APP_DIR}/server/job_id' 2>/dev/null" | tr -d '[:space:]'
}

server_start() {
  [[ "$BACKEND" == "ssh" ]] ||
    die "persistent server mode currently requires backend=ssh"
  validate_settings
  require_tools
  resolve_remote_layout
  set_resources

  server_cmd="sbatch --parsable --partition=${PARTITION}"
  server_cmd="$server_cmd --gres=dcu:${JOB_GPUS} --cpus-per-task=${JOB_CPUS}"
  server_cmd="$server_cmd --mem=${JOB_MEM} --time=${JOB_TIME}"
  server_cmd="$server_cmd --job-name=scnet-server-${MODEL}"
  server_cmd="$server_cmd --output=${REMOTE_APP_DIR}/server/slurm-%j.out"
  server_cmd="$server_cmd --error=${REMOTE_APP_DIR}/server/slurm-%j.err"
  server_cmd="$server_cmd --export=LC_ALL=C,LANG=C,LANGUAGE=C"
  server_cmd="$server_cmd,SCNET_SERVER_APP_DIR=${REMOTE_APP_DIR}"
  server_cmd="$server_cmd,SCNET_SERVER_MODEL=${MODEL_PATH}"
  server_cmd="$server_cmd,SCNET_LLAMA_SERVER=${LLAMA_SERVER}"
  server_cmd="$server_cmd,SCNET_SERVER_PORT=${SERVER_PORT}"
  server_cmd="$server_cmd ${REMOTE_APP_DIR}/server/llama-server.slurm"

  if (( DRY_RUN == 1 )); then
    say "persistent_model=$MODEL"
    say "persistent_binary=$(redact_remote_path "$LLAMA_SERVER")"
    say "persistent_port=$SERVER_PORT"
    say "resources=dcu:${JOB_GPUS} cpu:${JOB_CPUS} mem:${JOB_MEM} time:${JOB_TIME}"
    say "$server_cmd" | sed "s#${REMOTE_HOME}#\\\$REMOTE_HOME#g"
    return 0
  fi

  existing="$(server_job_id || true)"
  if [[ "$existing" =~ ^[0-9]+$ ]]; then
    existing_state="$(job_state "$existing")"
    if [[ "$existing_state" == "RUNNING" || "$existing_state" == "PENDING" ]]; then
      active_model="$(ssh_run "cat '${REMOTE_APP_DIR}/server/model' 2>/dev/null" || true)"
      if [[ -n "$active_model" && "$active_model" != "$MODEL_PATH" ]]; then
        die "persistent server is running a different model; run /serve stop first"
      fi
      ok "Persistent server already active: job=$existing model=$MODEL"
      return 0
    fi
  fi

  init_state
  ensure_worker
  output="$(ssh_run "$server_cmd")" || die "persistent server sbatch failed"
  job_id="${output%%;*}"
  case "$job_id" in ""|*[!0-9]*) die "cannot parse server job id: $output" ;; esac
  ssh_run "printf '%s\n' '$job_id' > '${REMOTE_APP_DIR}/server/job_id' && printf '%s\n' '$MODEL_PATH' > '${REMOTE_APP_DIR}/server/model'" ||
    die "cannot record persistent server job id; submitted job=$job_id"
  ok "Started persistent server job=$job_id model=$MODEL"
  last=""
  started_waiting_at="$(date '+%s')"
  while :; do
    state="$(job_state "$job_id")"
    if [[ "$state" != "$last" ]]; then
      info "server job=$job_id state=${state:-WAITING}"
      last="$state"
    fi
    case "$state" in
      FAILED|CANCELLED|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL)
        die "persistent server failed; inspect ${REMOTE_APP_DIR}/server/slurm-${job_id}.err"
        ;;
    esac
    if ssh_run "srun --jobid='$job_id' --overlap curl -fsS --max-time 3 http://127.0.0.1:${SERVER_PORT}/health" >/dev/null 2>&1; then
      ok "Persistent server is ready on port $SERVER_PORT"
      return 0
    fi
    now="$(date '+%s')"
    if (( now - started_waiting_at >= SERVER_START_TIMEOUT )); then
      die "persistent server did not become ready within ${SERVER_START_TIMEOUT}s; job=$job_id remains submitted, run /serve stop to cancel it"
    fi
    sleep "$POLL_SECONDS"
  done
}

server_stop() {
  [[ "$BACKEND" == "ssh" ]] ||
    die "persistent server mode currently requires backend=ssh"
  validate_settings
  require_tools
  resolve_remote_layout
  job_id="$(server_job_id || true)"
  case "$job_id" in
    ""|*[!0-9]*) warn "No persistent server job found"; return 0 ;;
  esac
  job_name="$(ssh_run "squeue -h -j '$job_id' -o '%j' | head -n 1; sacct -X -j '$job_id' --format=JobName -n -P | head -n 1" 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
  case "$job_name" in
    scnet-server-*) ;;
    "") die "cannot verify persistent server job=$job_id; refusing to cancel" ;;
    *) die "job=$job_id is not a scnet-aichat server job; refusing to cancel" ;;
  esac
  ssh_run "scancel '$job_id'" || die "persistent server scancel failed"
  ssh_run "rm -f '${REMOTE_APP_DIR}/server/job_id'" || true
  ok "Stopped persistent server job=$job_id"
}

server_status() {
  [[ "$BACKEND" == "ssh" ]] ||
    die "persistent server mode currently requires backend=ssh"
  validate_settings
  require_tools
  resolve_remote_layout
  job_id="$(server_job_id || true)"
  case "$job_id" in
    ""|*[!0-9]*) warn "No persistent server job found"; return 0 ;;
  esac
  ssh_run "sacct -j '$job_id' --format=JobID,JobName,Partition,State,ExitCode,Elapsed,AllocTRES -P"
}

json_quote() {
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
  elif command -v perl >/dev/null 2>&1; then
    printf '%s' "$1" | perl -0pe 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g; s/\t/\\t/g; $_ = "\"" . $_ . "\"";'
  else
    die "server mode requires python3 or perl for JSON encoding"
  fi
}

apply_preset() {
  case "$1" in
    default)
      PRESET=default
      SYSTEM_PROMPT="$DEFAULT_SYSTEM_PROMPT"
      ;;
    eva-rp)
      PRESET=eva-rp
      SYSTEM_PROMPT="$EVA_RP_SYSTEM_PROMPT"
      ;;
    *)
      return 1
      ;;
  esac
}

show_preset() {
  printf 'preset=%s\n' "$PRESET"
  printf 'system_prompt=%s\n' "$SYSTEM_PROMPT"
}

server_prompt() {
  [[ "$BACKEND" == "ssh" ]] ||
    die "persistent server mode currently requires backend=ssh"
  prompt="$1"
  validate_settings
  require_tools
  resolve_remote_layout
  if (( DRY_RUN == 1 )); then
    server_start
    return 0
  fi
  server_start
  job_id="$(server_job_id)"
  request_file="$(mktemp "${TMPDIR:-/tmp}/scnet-aichat-server.XXXXXX")" ||
    die "cannot create server request file"
  system_json="$(json_quote "$SYSTEM_PROMPT")"
  prompt_json="$(json_quote "$prompt")"
  printf '{"messages":[{"role":"system","content":%s},{"role":"user","content":%s}],"max_tokens":%s,"temperature":0.7,"top_p":0.9}\n' \
    "$system_json" "$prompt_json" "$MAX_TOKENS" > "$request_file"
  remote_request="${REMOTE_APP_DIR}/server/request-$$-${RANDOM}.json"
  LC_ALL=C LANG=C scp -q "$request_file" "${PROFILE}:${remote_request}" || {
    rm -f "$request_file"
    die "server request upload failed"
  }
  rm -f "$request_file"
  response="$(ssh_run "srun --jobid='$job_id' --overlap curl -fsS --max-time 600 http://127.0.0.1:${SERVER_PORT}/v1/chat/completions -H 'Content-Type: application/json' --data-binary '@${remote_request}'; rc=\$?; rm -f '${remote_request}'; exit \$rc")" ||
    die "persistent server request failed"
  if command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$response" | python3 -c 'import json,sys; x=json.load(sys.stdin); print(x["choices"][0]["message"]["content"])' 2>/dev/null ||
      printf '%s\n' "$response"
  else
    printf '%s\n' "$response"
  fi
}

show_status() {
  case "$1" in ""|*[!0-9]*) die "JOB_ID must be numeric" ;; esac
  original_backend="$BACKEND"
  init_state
  recorded_backend="$(lookup_backend "$1")"
  if [[ -n "$recorded_backend" && "$recorded_backend" != "$BACKEND" ]]; then
    BACKEND="$recorded_backend"
    reset_remote_layout
  fi
  validate_settings
  require_tools
  if [[ "$BACKEND" == "openapi" ]]; then
    resolve_remote_layout
    openapi_run job "$1"
  else
    ssh_run "sacct -j '$1' --format=JobID,JobName,Partition,State,ExitCode,Elapsed,AllocTRES -P"
  fi
  BACKEND="$original_backend"
  reset_remote_layout
}

show_result() {
  case "$1" in ""|*[!0-9]*) die "JOB_ID must be numeric" ;; esac
  init_state
  request_dir="$(lookup_request "$1")"
  [[ -n "$request_dir" ]] || die "job $1 is not in the local history"
  original_backend="$BACKEND"
  recorded_backend="$(lookup_backend "$1")"
  if [[ -n "$recorded_backend" && "$recorded_backend" != "$BACKEND" ]]; then
    BACKEND="$recorded_backend"
    reset_remote_layout
  fi
  validate_settings
  require_tools
  resolve_remote_layout
  state_now="$(job_state "$1")"
  info "job=$1 state=${state_now:-UNKNOWN}"

  if [[ "$BACKEND" == "openapi" ]]; then
    answer="$(openapi_run read "${request_dir}/answer.txt" 2>/dev/null || true)"
    if [[ -n "$answer" ]]; then
      printf '\n%sAnswer%s\n\n' "$BOLD" "$RESET"
      printf '%s\n\n' "$answer"
    else
      warn "answer is not available yet"
    fi
    printf '%sPerformance%s\n' "$BOLD" "$RESET"
    error_log="$(openapi_run read "${request_dir}/slurm-$1.err" 2>/dev/null || true)"
    printf '%s\n' "$error_log" |
      grep -aE 'load time|prompt eval time|eval time|total time' |
      tail -n 5 || true
    if [[ "$state_now" != "COMPLETED" ]]; then
      printf '\n%sError log tail%s\n' "$BOLD" "$RESET"
      printf '%s\n' "$error_log" | tail -n 30
    fi
  else
    if ssh_run "test -f '${request_dir}/answer.txt'" >/dev/null 2>&1; then
      printf '\n%sAnswer%s\n\n' "$BOLD" "$RESET"
      ssh_run "cat '${request_dir}/answer.txt'"
      printf '\n'
    else
      warn "answer is not available yet"
    fi

    printf '%sPerformance%s\n' "$BOLD" "$RESET"
    ssh_run "grep -aE 'load time|prompt eval time|eval time|total time' '${request_dir}/slurm-$1.err' 2>/dev/null | tail -n 5" ||
      true
    if [[ "$state_now" != "COMPLETED" ]]; then
      printf '\n%sError log tail%s\n' "$BOLD" "$RESET"
      ssh_run "tail -n 30 '${request_dir}/slurm-$1.err' 2>/dev/null" || true
    fi
  fi
  BACKEND="$original_backend"
  reset_remote_layout
}

wait_for_job() {
  if [[ "$BACKEND" == "openapi" ]]; then
    if openapi_run wait "$1" --poll-seconds "$POLL_SECONDS"; then
      show_result "$1"
      return 0
    fi
    show_result "$1"
    return 1
  fi
  last=""
  while :; do
    current="$(job_state "$1")"
    if [[ "$current" != "$last" ]]; then
      info "job=$1 state=${current:-WAITING_FOR_ACCOUNTING}"
      last="$current"
    fi
    case "$current" in
      COMPLETED) show_result "$1"; return 0 ;;
      FAILED|CANCELLED|CANCELLED+|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED)
        show_result "$1"; return 1 ;;
    esac
    sleep "$POLL_SECONDS"
  done
}

cancel_job() {
  case "$1" in ""|*[!0-9]*) die "JOB_ID must be numeric" ;; esac
  original_backend="$BACKEND"
  init_state
  recorded_backend="$(lookup_backend "$1")"
  if [[ -n "$recorded_backend" && "$recorded_backend" != "$BACKEND" ]]; then
    BACKEND="$recorded_backend"
    reset_remote_layout
  fi
  validate_settings
  require_tools
  if [[ "$BACKEND" == "openapi" ]]; then
    resolve_remote_layout
    openapi_run cancel "$1" >/dev/null || die "OpenAPI cancellation failed"
  else
    ssh_run "scancel '$1'" || die "scancel failed"
  fi
  ok "Cancellation requested for job $1"
  BACKEND="$original_backend"
  reset_remote_layout
}

show_history() {
  init_state
  printf 'JOB_ID\tMODEL\tSUBMITTED_AT\tBACKEND\n'
  tail -n 30 "$JOBS_FILE" |
    awk -F '	' 'BEGIN { OFS = "\t" } {
      backend = ($5 == "" ? "ssh" : $5)
      print $1, $3, $4, backend
    }'
}

doctor() {
  validate_settings
  require_tools
  ok "Local prerequisites are available; Bash ${BASH_VERSION}"
  if [[ "$BACKEND" == "openapi" ]]; then
    openapi_run doctor || die "OpenAPI doctor failed"
    find_worker || die "cannot find scnet-aichat-worker.slurm"
    ok "OpenAPI helper and local worker are available"
    return 0
  fi
  resolve_remote_layout
  ssh_run "test -x '${REMOTE_APP_DIR}/worker.slurm' && echo worker=ok || echo worker=missing; test -x '${REMOTE_APP_DIR}/server/llama-server.slurm' && echo server_script=ok || echo server_script=missing; test -x '$LLAMA_CLI' && echo llama_cli=ok || echo llama_cli=missing; test -x '$LLAMA_SERVER' && echo llama_server=ok || echo llama_server=missing; stat -c 'model_14b=%s' '$MODEL_14B_PATH'; stat -c 'model_32b=%s' '$MODEL_32B_PATH'; sinfo -p '$PARTITION' -h -o 'partition=%P state=%a nodes=%D' | head -n 1"
}

setup_openapi() {
  command -v python3 >/dev/null 2>&1 || die "OpenAPI setup requires python3"
  find_openapi_helper || die "cannot find scripts/scnet-openapi.py"
  action="${1:-auto}"
  case "$action" in auto|new|modify|status|reset|reset-credentials) ;; *)
    die "setup action must be new, modify, status, reset, or reset-credentials"
  esac
  openapi_run setup "$action"
}

panel_help() {
  cat <<'EOF'
Enter a question to submit a Slurm job.

Commands:
  /backend ssh|openapi
  /mode job|server
  /preset default|eva-rp
  /preset show
  /serve start
  /serve status
  /serve stop
  /model 14b|32b
  /tokens N
  /system TEXT
  /file PATH
  /status JOB_ID
  /result JOB_ID
  /cancel JOB_ID
  /history
  /doctor
  /install
  /help
  /quit
EOF
}

interactive_panel() {
  validate_settings
  require_tools
  resolve_remote_layout
  init_state
  printf '%sSCNet AI Chat%s\n' "$BOLD" "$RESET"
  say "Backend=$BACKEND; mode=$MODE; questions run on $PARTITION."
  panel_help

  while :; do
    printf '\n%s[%s backend=%s mode=%s preset=%s tokens=%s]%s > ' \
      "$BOLD" "$MODEL" "$BACKEND" "$MODE" "$PRESET" "$MAX_TOKENS" "$RESET"
    IFS= read -r line || break
    [[ -n "$line" ]] || continue
    cmd="${line%% *}"
    arg="${line#"$cmd"}"
    arg="${arg# }"
    case "$cmd" in
      /quit|/exit) break ;;
      /help) panel_help ;;
      /backend)
        case "$arg" in
          ssh|openapi)
            if [[ "$MODE" == "server" && "$arg" == "openapi" ]]; then
              warn "persistent server mode currently requires backend=ssh"
            else
              BACKEND="$arg"
              reset_remote_layout
              validate_settings
              require_tools
              resolve_remote_layout
              ok "backend=$BACKEND"
            fi
            ;;
          *) warn "usage: /backend ssh|openapi" ;;
        esac
        ;;
      /model)
        case "$arg" in 14b|32b) MODEL="$arg"; ok "model=$MODEL" ;; *) warn "usage: /model 14b|32b" ;; esac
        ;;
      /mode)
        case "$arg" in
          job) MODE=job; ok "mode=job" ;;
          server) MODE=server; server_start ;;
          *) warn "usage: /mode job|server" ;;
        esac
        ;;
      /preset)
        case "$arg" in
          default|eva-rp)
            apply_preset "$arg"
            ok "preset=$PRESET"
            ;;
          show)
            show_preset
            ;;
          list|"")
            say "available presets: default, eva-rp"
            ;;
          *)
            warn "usage: /preset default|eva-rp|show"
            ;;
        esac
        ;;
      /serve)
        case "$arg" in
          start) server_start ;;
          status) server_status ;;
          stop) server_stop ;;
          *) warn "usage: /serve start|status|stop" ;;
        esac
        ;;
      /tokens)
        case "$arg" in ""|*[!0-9]*) warn "usage: /tokens 1-4096"; continue ;; esac
        if (( arg < 1 || arg > 4096 )); then warn "usage: /tokens 1-4096"; continue; fi
        MAX_TOKENS="$arg"; ok "max_tokens=$MAX_TOKENS"
        ;;
      /system)
        if [[ -n "$arg" ]]; then
          SYSTEM_PROMPT="$arg"
          PRESET=custom
          ok "system prompt updated; preset=custom"
        else
          show_preset
        fi
        ;;
      /file) if [[ -f "$arg" ]]; then submit_prompt "$(cat "$arg")"; else warn "file not found: $arg"; fi ;;
      /status) show_status "$arg" ;;
      /result) show_result "$arg" ;;
      /cancel) cancel_job "$arg" ;;
      /history) show_history ;;
      /doctor) doctor ;;
      /install) install_worker ;;
      /*) warn "unknown command: $cmd" ;;
      *)
        if [[ "$MODE" == "server" ]]; then
          server_prompt "$line"
        else
          submit_prompt "$line"
        fi
        ;;
    esac
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend) [[ $# -ge 2 ]] || die "--backend needs a value"; BACKEND="$2"; shift 2 ;;
    --profile) [[ $# -ge 2 ]] || die "--profile needs a value"; PROFILE="$2"; shift 2 ;;
    --partition) [[ $# -ge 2 ]] || die "--partition needs a value"; PARTITION="$2"; shift 2 ;;
    --model) [[ $# -ge 2 ]] || die "--model needs a value"; MODEL="$2"; shift 2 ;;
    --mode) [[ $# -ge 2 ]] || die "--mode needs a value"; MODE="$2"; shift 2 ;;
    --preset)
      [[ $# -ge 2 ]] || die "--preset needs a value"
      apply_preset "$2" || die "--preset must be default or eva-rp"
      shift 2
      ;;
    --max-tokens) [[ $# -ge 2 ]] || die "--max-tokens needs a value"; MAX_TOKENS="$2"; shift 2 ;;
    --poll-seconds) [[ $# -ge 2 ]] || die "--poll-seconds needs a value"; POLL_SECONDS="$2"; shift 2 ;;
    --system)
      [[ $# -ge 2 ]] || die "--system needs a value"
      SYSTEM_PROMPT="$2"
      PRESET=custom
      shift 2
      ;;
    --no-wait) WAIT_FOR_RESULT=0; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

command="${1:-panel}"
[[ $# -eq 0 ]] || shift
case "$command" in
  panel) interactive_panel ;;
  setup) setup_openapi "${1:-auto}" ;;
  install) install_worker ;;
  doctor) doctor ;;
  ask) [[ $# -gt 0 ]] || die "ask needs a question"; if [[ "$MODE" == "server" ]]; then server_prompt "$*"; else submit_prompt "$*"; fi ;;
  status) [[ $# -eq 1 ]] || die "status needs JOB_ID"; show_status "$1" ;;
  result) [[ $# -eq 1 ]] || die "result needs JOB_ID"; show_result "$1" ;;
  cancel) [[ $# -eq 1 ]] || die "cancel needs JOB_ID"; cancel_job "$1" ;;
  history) show_history ;;
  *) usage; die "unknown command: $command" ;;
esac
